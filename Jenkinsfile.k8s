pipeline {
    agent any

    environment {
        EC2_USER = "ubuntu"
        APP_NAME = "maven-app"
        IMAGE    = "rferns/maven-app:latest"
    }

    stages {

        stage('Checkout Source') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/rferns0008/maven_app.git'
            }
        }

        stage('Resolve EC2 Host from Ansible Inventory') {
            steps {
                script {
                    EC2_HOST = sh(
                        script: """
                          awk '
                            /^\\[target\\]/ {found=1; next}
                            found && NF {print \\$1; exit}
                          ' ansible/hosts.ini
                        """,
                        returnStdout: true
                    ).trim()

                    if (!EC2_HOST) {
                        error "❌ Failed to resolve EC2 host from ansible/hosts.ini"
                    }

                    echo "✅ Using EC2 host from ansible inventory: ${EC2_HOST}"
                }
            }
        }

        stage('Copy Kubernetes Manifests to EC2') {
            steps {
                sh """
                  ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} 'mkdir -p /home/ubuntu/k8s'
                  scp -o StrictHostKeyChecking=no k8s/*.yml \
                      ${EC2_USER}@${EC2_HOST}:/home/ubuntu/k8s/
                """
            }
        }

        stage('Deploy to Existing Minikube') {
            steps {
                sh """
                  ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} << 'EOF'
                    kubectl apply -f /home/ubuntu/k8s/deploy.yml
                    kubectl apply -f /home/ubuntu/k8s/service.yml
                    kubectl rollout status deployment/maven-app
                  EOF
                """
            }
        }
    }

    post {
        success {
            echo "✅ Kubernetes deployment completed using Ansible inventory IP"
        }
        failure {
            echo "❌ Kubernetes deployment failed"
        }
    }
}
