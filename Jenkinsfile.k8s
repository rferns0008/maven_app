pipeline {
    agent any

    environment {
        SSH_USER = "ubuntu"
        APP_NAME = "maven-app"
        IMAGE    = "rferns/maven-app:latest"
    }

    stages {

        stage('Checkout Source') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/rferns0008/maven_app.git'
            }
        }

        stage('Resolve Minikube Host from Ansible Inventory') {
            steps {
                script {
                    def host = sh(
                        script: '''
                          awk '
                            $0 == "[target]" {found=1; next}
                            found && NF {print $1; exit}
                          ' ansible/hosts.ini
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!host) {
                        error "❌ Could not resolve EC2 host from ansible/hosts.ini"
                    }

                    env.EC2_HOST = host
                    echo "✅ Minikube host resolved from inventory: ${env.EC2_HOST}"
                }
            }
        }

        stage('Deploy Existing Image to Minikube') {
            steps {
                sshagent(credentials: ['ec2-ssh-key']) {
                    sh """
                      ssh -o StrictHostKeyChecking=no ${SSH_USER}@${env.EC2_HOST} << 'EOF'
                        kubectl apply -f /home/ubuntu/k8s/deploy.yml
                        kubectl apply -f /home/ubuntu/k8s/service.yml
                        kubectl rollout status deployment/maven-app
                      EOF
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Existing image deployed successfully to Minikube"
        }
        failure {
            echo "❌ Minikube deployment failed"
        }
    }
}
