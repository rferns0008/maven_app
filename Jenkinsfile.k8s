pipeline {
    agent any

    environment {
        SSH_USER = "ubuntu"
        APP_NAME = "maven-app"
        IMAGE    = "rferns/maven-app:latest"
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Resolve Minikube Host from Ansible Inventory') {
            steps {
                script {
                    def host = powershell(
                        script: '''
                        $found = $false
                        Get-Content ansible\\hosts.ini | ForEach-Object {
                            if ($_ -eq "[target]") { $found = $true; return }
                            if ($found -and $_.Trim() -ne "") {
                                ($_ -split "\\s+")[0]
                                break
                            }
                        }
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!host) {
                        error "❌ Could not resolve EC2 host from ansible/hosts.ini"
                    }

                    env.EC2_HOST = host
                    echo "✅ Minikube host resolved from inventory: ${env.EC2_HOST}"
                }
            }
        }

        stage('Copy Kubernetes Manifests to EC2') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    bat '''
                    REM Convert Jenkins SSH key path to WSL path
                    for /f %%i in ('wsl wslpath "%SSH_KEY%"') do set WSL_KEY=%%i

                    REM Create k8s directory on EC2
                    wsl ssh -i %WSL_KEY% -o StrictHostKeyChecking=no %SSH_USER%@%EC2_HOST% "mkdir -p /home/ubuntu/k8s"

                    REM Copy Kubernetes manifests
                    wsl scp -i %WSL_KEY% -o StrictHostKeyChecking=no ^
                      k8s/deploy.yml k8s/service.yml ^
                      %SSH_USER%@%EC2_HOST%:/home/ubuntu/k8s/
                    '''
                }
            }
        }

        stage('Deploy Existing Image to Minikube') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    bat '''
                    REM Convert Jenkins SSH key path to WSL path
                    for /f %%i in ('wsl wslpath "%SSH_KEY%"') do set WSL_KEY=%%i

                    REM Deploy manifests into Minikube
                    wsl ssh -i %WSL_KEY% -o StrictHostKeyChecking=no %SSH_USER%@%EC2_HOST% "
                      minikube update-context &&
                      minikube kubectl -- apply -n dev -f /home/ubuntu/k8s/deploy.yml &&
                      minikube kubectl -- apply -n dev -f /home/ubuntu/k8s/service.yml &&
                      minikube kubectl -- rollout status deployment/maven-app -n dev
                    "
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Existing image deployed successfully to Minikube"
        }
        failure {
            echo "❌ Minikube deployment failed"
        }
    }
}