pipeline {
    agent any

    environment {
        SSH_USER = "ubuntu"
        APP_NAME = "maven-app"
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Resolve EC2 Host from Inventory') {
            steps {
                script {
                    def host = powershell(
                        script: '''
                        $found = $false
                        Get-Content ansible\\hosts.ini | ForEach-Object {
                            if ($_ -eq "[target]") { $found = $true; return }
                            if ($found -and $_.Trim() -ne "") {
                                ($_ -split "\\s+")[0]
                                break
                            }
                        }
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!host) {
                        error "Could not resolve EC2 host from ansible/hosts.ini"
                    }

                    env.EC2_HOST = host
                    echo "EC2 host resolved: ${env.EC2_HOST}"
                }
            }
        }

        stage('Prepare SSH Key in WSL') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    bat '''
                    REM Convert Jenkins-injected key path to WSL path
                    for /f %%i in ('wsl wslpath "%SSH_KEY%"') do set WSL_SRC_KEY=%%i

                    REM Create SSH directory and copy key into WSL filesystem
                    wsl mkdir -p ~/.ssh
                    wsl cp %WSL_SRC_KEY% ~/.ssh/jenkins_ec2_key
                    wsl chmod 600 ~/.ssh/jenkins_ec2_key
                    '''
                }
            }
        }

        stage('Copy Kubernetes Manifests to EC2') {
            steps {
                bat '''
                wsl ssh -i ~/.ssh/jenkins_ec2_key -o StrictHostKeyChecking=no %SSH_USER%@%EC2_HOST% "mkdir -p /home/ubuntu/k8s"

                wsl scp -i ~/.ssh/jenkins_ec2_key -o StrictHostKeyChecking=no ^
                  k8s/deploy.yml k8s/service.yml ^
                  %SSH_USER%@%EC2_HOST%:/home/ubuntu/k8s/
                '''
            }
        }

        stage('Deploy Existing Image to Minikube') {
            steps {
                bat '''
                wsl ssh -i ~/.ssh/jenkins_ec2_key -o StrictHostKeyChecking=no %SSH_USER%@%EC2_HOST% "
                  minikube update-context &&
                  minikube kubectl apply -n dev -f /home/ubuntu/k8s/deploy.yml &&
                  minikube kubectl apply -n dev -f /home/ubuntu/k8s/service.yml &&
                  minikube kubectl rollout status deployment/maven-app -n dev
                "
                '''
            }
        }
    }

    post {
        success {
            echo "Deployment to Minikube completed successfully"
        }
        failure {
            echo "Deployment to Minikube failed"
        }
    }
}