pipeline {
    agent any

    environment {
        SSH_USER = "ubuntu"
        APP_NAME = "maven-app"
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Resolve Minikube Host from Ansible Inventory') {
            steps {
                script {
                    def host = powershell(
                        script: '''
                        $found = $false
                        Get-Content ansible\\hosts.ini | ForEach-Object {
                            if ($_ -eq "[target]") { $found = $true; return }
                            if ($found -and $_.Trim() -ne "") {
                                ($_ -split "\\s+")[0]
                                break
                            }
                        }
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!host) {
                        error "Could not resolve EC2 host from ansible/hosts.ini"
                    }

                    env.EC2_HOST = host
                    echo "Minikube host resolved: ${env.EC2_HOST}"
                }
            }
        }

        stage('Copy Kubernetes Manifests to EC2') {
            steps {
                sshagent(credentials: ['ec2-ssh-key']) {
                    bat '''
                    wsl ssh -o StrictHostKeyChecking=no ubuntu@%EC2_HOST% "mkdir -p /home/ubuntu/k8s"

                    wsl scp -o StrictHostKeyChecking=no ^
                      k8s/deploy.yml k8s/service.yml ^
                      ubuntu@%EC2_HOST%:/home/ubuntu/k8s/
                    '''
                }
            }
        }

        stage('Deploy Existing Image to Minikube') {
            steps {
                sshagent(credentials: ['ec2-ssh-key']) {
                    bat '''
                    wsl ssh -o StrictHostKeyChecking=no ubuntu@%EC2_HOST% "
                      minikube update-context &&
                      minikube kubectl -- apply -n dev -f /home/ubuntu/k8s/deploy.yml &&
                      minikube kubectl -- apply -n dev -f /home/ubuntu/k8s/service.yml &&
                      minikube kubectl -- rollout status deployment/maven-app -n dev
                    "
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Deployment to Minikube completed successfully"
        }
        failure {
            echo "Minikube deployment failed"
        }
    }
}